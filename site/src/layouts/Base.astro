---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { waLink } from '../lib/format';
import { graph, organization } from '../lib/schema';

interface Props {
  title: string; // unique per page, ≤60 chars
  description: string; // unique per page, ≤155 chars
  schema?: object[];
  waMessage?: string;
}
const { title, description, schema = [], waMessage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0D0D0B" />
    <meta name="msapplication-TileColor" content="#0D0D0B" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumey Energy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_NG" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd data={graph(organization(), ...schema)} />
  </head>
  <body>
    <a class="lm-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <a class="lm-wa-fab" id="wa-fab" href={waLink(waMessage)} aria-label="Chat with Lumey on WhatsApp"><WhatsAppIcon /></a>
  </body>
</html>
